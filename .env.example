# =============================================================================
#  Unified Player — variáveis de ambiente
#  Copie este arquivo para `.env.local` e preencha os valores:
#      cp .env.example .env.local
#  Todas as variáveis abaixo são PÚBLICAS (prefixo NEXT_PUBLIC_) porque são
#  usadas no navegador. Nenhuma delas é um segredo: o fluxo do Spotify usa
#  PKCE (sem client secret) e a chave do YouTube deve ser restringida por
#  HTTP referrer no Google Cloud Console.
# =============================================================================

# -----------------------------------------------------------------------------
# SPOTIFY
# Onde gerar: https://developer.spotify.com/dashboard  →  Create app
#   - Marque "Web API" e "Web Playback SDK" em "Which API/SDKs are you planning to use?"
#   - Copie o "Client ID" (NÃO é necessário o Client Secret).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# URI para onde o Spotify devolve o usuário após o login.
# Precisa ser IDÊNTICA (caractere por caractere) a uma das "Redirect URIs"
# cadastradas no app do Spotify Dashboard.
# ATENÇÃO: o Spotify não aceita mais "localhost" — use o loopback 127.0.0.1
# e abra o app em http://127.0.0.1:3000 durante o desenvolvimento.
# Em produção: https://SEU-DOMINIO.com/callback
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# -----------------------------------------------------------------------------
# YOUTUBE
# Onde gerar: https://console.cloud.google.com/apis/credentials
#   1. Crie (ou selecione) um projeto.
#   2. Ative a "YouTube Data API v3" em APIs & Services → Library.
#   3. Credentials → Create credentials → API key.
#   4. Restrinja a chave: Application restrictions → Websites
#      (http://127.0.0.1:3000/* e o seu domínio de produção) e
#      API restrictions → YouTube Data API v3.
# Cota padrão: 10.000 unidades/dia; cada busca custa ~101 unidades.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_API_KEY=
